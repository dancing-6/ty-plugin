{
  "openapi": "3.1.0",
  "info": {
    "title": "Tavily Search",
    "description": "A search engine optimized for LLMs, aimed at efficient, quick and persistent search results.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api.tavily.com"
    }
  ],
  "paths": {
    "/search": {
      "post": {
        "description": "Performs a search using Tavily API and returns the results.",
        "operationId": "tavilySearch",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "query": {
                    "type": "string",
                    "description": "The search query."
                  },
                  "search_depth": {
                    "type": "string",
                    "enum": ["basic", "advanced"],
                    "description": "The depth of the search. 'basic' is faster, 'advanced' is more thorough.",
                    "default": "basic"
                  },
                  "include_answer": {
                    "type": "boolean",
                    "description": "Include a short answer to the query in the results.",
                    "default": false
                  },
                  "include_raw_content": {
                    "type": "boolean",
                    "description": "Include the raw content of the search results.",
                    "default": false
                  },
                  "max_results": {
                    "type": "integer",
                    "description": "The maximum number of search results to return.",
                    "default": 5
                  }
                },
                "required": ["query"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful search response."
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  },
  "security": [
    {
      "bearerAuth": []
    }
  ]
}
